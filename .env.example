# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Firebase Web Client API Key
FIREBASE_API_KEY=

# Firebase Admin SDK (Production Server-Side Credentials - Never commit real keys)
# Option 1: Full JSON string or base64-encoded JSON (Recommended for Cloud Run / Vercel / CI)
FIREBASE_SERVICE_ACCOUNT=
# Option 2: File path to mounted secret volume (Recommended for Secret Manager / Kubernetes)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option 3: Standard GCP application credentials path
GOOGLE_APPLICATION_CREDENTIALS=
# Option 4: Discrete fields
FIREBASE_PROJECT_ID=loginapp-feb72
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mail credentials (optional, for contact form email dispatch)
MAIL_USER=
MAIL_PASS=

# HuggingFace Token (optional, for api/llm)
HF_TOKEN=

# Google Custom Search (optional, for api/chatbot)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
